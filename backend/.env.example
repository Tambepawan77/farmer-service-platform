# Copy this file to ".env" and edit it.  (cp .env.example .env)

# LOCAL: SQLite file, nothing to install.
DATABASE_URL=sqlite:///./farmer.db

# AWS RDS PostgreSQL (use this on the server). Format:
# DATABASE_URL=postgresql+psycopg2://USERNAME:PASSWORD@RDS-ENDPOINT:5432/farmerdb
# Tip: use a password with only letters and numbers.

# Any long random text. Make one with:  openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-text

# true = on first start, add demo users and demo services
SEED_DEMO_DATA=true

# Extra allowed browser origins (comma separated). Not needed on AWS because nginx serves both.
CORS_ORIGINS=http://localhost:5173
